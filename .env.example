# ============================================
# Butwal Candle Hub — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Never commit .env to git.

# --- PUBLIC (Exposed to frontend, safe) ---
PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- PRIVATE (Server-side only, never exposed) ---
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- eSewa Payment Integration ---
# Get these from your eSewa merchant account
# Sandbox/Test URL: https://rc-epay.esewa.com.np
# Production URL: https://epay.esewa.com.np
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_API_URL=https://rc-epay.esewa.com.np
ESEWA_SUCCESS_URL=http://localhost:5173/payment/success
ESEWA_FAILURE_URL=http://localhost:5173/payment/failure
